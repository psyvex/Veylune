{
  "name": "veylune",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=11.19.0",
    "pnpm": ">=10.17.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web:dev": "npm --workspace @veylune/web run dev",
    "web:build": "npm --workspace @veylune/web run build",
    "web:typecheck": "npm --workspace @veylune/web run typecheck",
    "web:test": "npm --workspace @veylune/web run test"
  }
}
